# Local environment variables for cbl-connector.
HTTP_ADDR=:8050
GRPC_ADDR=:9050
METRICS_ADDR=:9250
PG_DSN=postgres://cbl:cbl@localhost:5432/connector?sslmode=disable
KAFKA_BROKERS=localhost:9092
KAFKA_CONSUMER_GROUP=cbl-connector-webhooks
CONNECTOR_SANDBOX_PROVIDERS=mock
REDIS_ADDR=localhost:6379
CONNECTOR_RETRY_MAX_ATTEMPTS=3
CONNECTOR_RETRY_BASE_DELAY=100ms
CONNECTOR_RETRY_MAX_DELAY=1s
CONNECTOR_BREAKER_FAILURE_THRESHOLD=5
CONNECTOR_BREAKER_TIMEOUT=30s
CONNECTOR_BREAKER_HALF_OPEN_REQUESTS=1
CONNECTOR_BULKHEAD_MAX_CONCURRENT=32
CONNECTOR_ROUTE_CACHE_TTL=30s
REDIS_PASSWORD=
# Sandbox stands (17.26): the per-order CoinGate callback URL of our ingress
# (empty omits the field), the CoinGate fiat price currency for stablecoin
# orders (CoinGate rejects crypto price currencies) and the BitPay sandbox
# buyer contact (mock pay only, never set in production).
CONNECTOR_COINGATE_CALLBACK_URL=
CONNECTOR_COINGATE_PRICE_CURRENCY=
CONNECTOR_BITPAY_BUYER_EMAIL=
